// Application icon for Marked-text-down (Windows)
#include <winver.h>

IDI_ICON1 ICON "mtd-logo.ico"

1 VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Marked-text-down Markdown editor"
            VALUE "ProductName", "Marked-text-down"
            VALUE "ProductVersion", "1.1.0"
            VALUE "OriginalFilename", "marked-text-down.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
